{
  "name": "babyfunken",
  "version": "2.0.0",
  "private": true,
  "description": "Babyfunken \u2014 a peer-to-peer baby monitor for Android, web and desktop.",
  "license": "MIT",
  "workspaces": [
    "shared",
    "server",
    "webapp",
    "mobile"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "server": "npm start --workspace @babyfunken/server",
    "webapp": "npm run dev --workspace @babyfunken/webapp",
    "mobile": "npm start --workspace @babyfunken/mobile",
    "assets": "./scripts/generate-assets.sh && python3 scripts/generate-lullabies.py"
  },
  "overrides": {
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.14",
    "node-forge": "1.4.3",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2",
    "undici": "6.29.1",
    "qs": "6.16.1",
    "fast-uri": "3.1.9",
    "body-parser": "2.4.0",
    "proxy-addr": "2.0.8",
    "postcss": "8.5.23",
    "vite": "8.3.3",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "zod": "4.6.6"
  }
}
