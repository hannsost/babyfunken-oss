# ─── Babyfunken signaling server ───────────────────────────────
# Copy to .env and fill in. See docs/DEPLOYMENT.md for the full guide.

NODE_ENV=production
PORT=8002
HOST=0.0.0.0

# Exact origins allowed to open a socket. Never "*" in production.
ALLOWED_ORIGINS=https://app.example.org

# Number of reverse-proxy hops in front of this process.
TRUST_PROXY_HOPS=1

# ─── TURN relay (coturn) ───────────────────────────────────────
# Must match `static-auth-secret` in turnserver.conf. The server mints
# short-lived credentials from it; the secret itself never reaches a client.
TURN_SECRET=change-me-generate-with-openssl-rand-hex-32
TURN_URLS=turn:turn.example.org:3478?transport=udp,turn:turn.example.org:3478?transport=tcp,turns:turn.example.org:5349?transport=tcp
TURN_TTL_SECONDS=43200

# Public STUN. Used for direct connections, which is the common case.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ─── Abuse limits ──────────────────────────────────────────────
RATE_LIMIT_JOIN_ATTEMPTS=10
RATE_LIMIT_JOIN_WINDOW_MS=60000
RATE_LIMIT_CREATE_PER_HOUR=20
RATE_LIMIT_BLOCK_MS=900000

# Serve the built webapp from this process (set false if a CDN does it).
SERVE_WEBAPP=true
